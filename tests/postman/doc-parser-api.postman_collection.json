{
	"info": {
		"_postman_id": "doc-parser-api-v1",
		"name": "Doc Parser API v1",
		"description": "Enterprise document parsing service - MinerU VLM/Pipeline + Docling\n\n## 环境变量\n- `base_url`: API 服务地址 (默认 http://localhost:8000)\n- `document_id`: 文档ID (由 process 接口自动设置)\n- `task_id`: 任务ID (由 async 接口自动设置)\n\n## 测试文件\n使用项目根目录下的 `PDFTest/DeepSeek_V4.pdf` 作为测试文件",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "0. Health & Info",
			"description": "健康检查和引擎信息接口",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/health",
							"host": ["{{base_url}}"],
							"path": ["v1", "health"]
						},
						"description": "健康检查 - 返回服务状态和所有引擎的健康状况"
					},
					"response": []
				},
				{
					"name": "List Engines",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/engines",
							"host": ["{{base_url}}"],
							"path": ["v1", "engines"]
						},
						"description": "列出所有可用的解析引擎及其支持的格式"
					},
					"response": []
				}
			]
		},
		{
			"name": "1. Parse",
			"description": "文档解析 - 核心解析接口",
			"item": [
				{
					"name": "Parse Document (auto)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const json = pm.response.json();",
									"pm.test('Has document_id', () => pm.expect(json.document_id).to.be.a('string'));",
									"pm.test('Has content_list', () => pm.expect(json.content_list).to.be.an('array'));",
									"pm.test('Has markdown', () => pm.expect(json.markdown).to.be.a('string'));",
									"pm.environment.set('document_id', json.document_id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "PDFTest/DeepSeek_V4.pdf",
									"description": "上传的PDF文件"
								},
								{
									"key": "engine",
									"type": "text",
									"value": "auto",
									"description": "解析引擎: auto | mineru | mineru-vlm | docling"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/v1/parse",
							"host": ["{{base_url}}"],
							"path": ["v1", "parse"]
						},
						"description": "同步解析文档 - 自动选择引擎\n\n**Form参数:**\n- `file`: 上传的文件 (必填)\n- `engine`: 解析引擎，可选 `auto` | `mineru` | `mineru-vlm` | `docling` (默认 auto)"
					},
					"response": []
				},
				{
					"name": "Parse Document (mineru)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const json = pm.response.json();",
									"pm.test('Engine is mineru', () => pm.expect(json.engine).to.include('mineru'));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "PDFTest/DeepSeek_V4.pdf"
								},
								{
									"key": "engine",
									"type": "text",
									"value": "mineru"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/v1/parse",
							"host": ["{{base_url}}"],
							"path": ["v1", "parse"]
						},
						"description": "同步解析文档 - 指定 MinerU Pipeline 引擎"
					},
					"response": []
				},
				{
					"name": "Parse Document (mineru-vlm)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const json = pm.response.json();",
									"pm.test('Engine is vlm', () => pm.expect(json.engine).to.include('vlm'));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "PDFTest/DeepSeek_V4.pdf"
								},
								{
									"key": "engine",
									"type": "text",
									"value": "mineru-vlm"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/v1/parse",
							"host": ["{{base_url}}"],
							"path": ["v1", "parse"]
						},
						"description": "同步解析文档 - 指定 MinerU VLM 引擎（视觉语言模型）"
					},
					"response": []
				},
				{
					"name": "Parse Async",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const json = pm.response.json();",
									"pm.test('Has task_id', () => pm.expect(json.task_id).to.be.a('string'));",
									"pm.test('Status is pending or processing', () => pm.expect(['pending','processing']).to.include(json.status));",
									"pm.environment.set('task_id', json.task_id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "PDFTest/DeepSeek_V4.pdf"
								},
								{
									"key": "engine",
									"type": "text",
									"value": "auto"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/v1/parse/async",
							"host": ["{{base_url}}"],
							"path": ["v1", "parse", "async"]
						},
						"description": "异步解析文档 - 立即返回 task_id，后台执行解析\n\n**Form参数:**\n- `file`: 上传的文件 (必填)\n- `engine`: 解析引擎 (默认 auto)"
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Task Management",
			"description": "任务管理 - 查询异步任务状态和结果",
			"item": [
				{
					"name": "Get Task Status",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const json = pm.response.json();",
									"pm.test('Has task_id', () => pm.expect(json.task_id).to.be.a('string'));",
									"pm.test('Has status', () => pm.expect(json.status).to.be.a('string'));",
									"if (json.status === 'success' && json.result) {",
									"    pm.test('Result has content_list', () => pm.expect(json.result.content_list).to.be.an('array'));",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/task/{{task_id}}",
							"host": ["{{base_url}}"],
							"path": ["v1", "task", "{{task_id}}"]
						},
						"description": "查询异步任务状态\n\n**路径参数:**\n- `task_id`: 异步任务返回的任务ID\n\n**响应字段:**\n- `status`: pending | processing | success | failed\n- `result`: 成功时返回解析结果\n- `process_result`: 成功时返回全流程结果(仅process/async)"
					},
					"response": []
				},
				{
					"name": "List Tasks",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const json = pm.response.json();",
									"pm.test('Returns array', () => pm.expect(json).to.be.an('array'));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/tasks",
							"host": ["{{base_url}}"],
							"path": ["v1", "tasks"]
						},
						"description": "列出所有异步任务"
					},
					"response": []
				}
			]
		},
