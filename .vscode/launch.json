{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Doc Parser API Server",
      "type": "debugpy",
      "request": "launch",
      "module": "doc_parser.api.server",
      "args": ["--host", "0.0.0.0", "--port", "8000", "--reload", "--config", "config.json"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "justMyCode": false
    },
    {
      "name": "Pytest Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "--tb=short"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "justMyCode": false
    },
    {
      "name": "Pytest All",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v", "--tb=short"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "justMyCode": false
    }
  ]
}
